# Install everything:      brew bundle --file ~/.dotfiles/Brewfile   (or ./install.sh --brew)
# Check what's missing:    brew bundle check --file ~/.dotfiles/Brewfile
# List what's not listed:  brew bundle cleanup --file ~/.dotfiles/Brewfile

tap "nats-io/nats-tools"

